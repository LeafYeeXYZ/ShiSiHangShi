{
  "name": "sonnet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp fmt && vp lint",
    "fonts:build": "uv run scripts/subset_font.py",
    "cf:types": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply SONNET_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SONNET_DB --remote",
    "deploy:check": "vp build && wrangler deploy --dry-run",
    "deploy": "vp build && wrangler d1 migrations apply SONNET_DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.5",
    "html2canvas-pro": "^2.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swiper": "^14.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "hono": "^4.13.13",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.149.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  }
}
